# VELTRIX — Environment Variables
# Copy this file to .env and fill in your values.
# None of these are required to run the website.
# They are placeholders for future backend integrations.

# Contact form backend (e.g. EmailJS, Resend, or custom API)
# VITE_CONTACT_FORM_API_URL=
# VITE_CONTACT_FORM_API_KEY=

# Analytics (e.g. Google Analytics 4)
# VITE_GA_MEASUREMENT_ID=

# Site base URL (used for SEO canonical URLs)
# VITE_SITE_URL=https://veltrix.dev
