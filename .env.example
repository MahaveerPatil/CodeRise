# CodeRise Environment Variables — copy to .env and fill in values

# Supabase (get from: supabase.com > your project > Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# WhatsApp number with country code (no + or spaces)
VITE_WHATSAPP_NUMBER=918310659343

# Cloudflare Worker API URL (set after deploying the worker)
VITE_CLOUDFLARE_WORKER_URL=https://coderise-api.your-subdomain.workers.dev
