# CodeRise Environment Variables — copy to .env and fill in values

# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are no longer used by the frontend.
# All Supabase access goes through the Cloudflare Worker (server-side only).
# Set worker secrets instead:
#   cd worker && npx wrangler secret put SUPABASE_SERVICE_KEY
# (SUPABASE_URL is already in worker/wrangler.toml [vars])

# WhatsApp number with country code (no + or spaces) — widget is hidden if not set
VITE_WHATSAPP_NUMBER=918310659343

# Cloudflare Worker API URL (set after deploying the worker)
VITE_CLOUDFLARE_WORKER_URL=https://coderise-api.your-subdomain.workers.dev

# === Cloudflare Pages environment variables (NOT local .env vars) ===
# Set these in: Cloudflare Dashboard → Pages → your project → Settings → Environment Variables
#
# These protect the /admin route with HTTP Basic Auth at the edge (before any HTML is served):
#   ADMIN_BASIC_AUTH_USER=adminuser
#   ADMIN_BASIC_AUTH_HASH=<bcrypt_hash_of_password>
#
# To generate the bcrypt hash (requires apache2-utils or equivalent):
#   htpasswd -bnBC 10 "" yourpassword | tr -d ':\n'
# Paste the output as the value of ADMIN_BASIC_AUTH_HASH in the Cloudflare dashboard.
